# Copy via ./setup.sh (generates the random secrets for you), then fill in Proton creds.

# --- ProtonVPN credentials -------------------------------------------------
# WireGuard (recommended): account.proton.me > Downloads > WireGuard configuration,
# generate a config and copy the PrivateKey value.
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=

# OpenVPN alternative: set VPN_TYPE=openvpn and use the OpenVPN/IKEv2 username +
# password from account.proton.me > Account > OpenVPN/IKEv2 (NOT your login).
OPENVPN_USER=
OPENVPN_PASSWORD=

# --- Server pool -----------------------------------------------------------
# Rotation picks a random server from this pool. More countries = more IPs.
SERVER_COUNTRIES=Netherlands,Belgium,Germany
SERVER_CITIES=
FREE_ONLY=off

# --- Exposure --------------------------------------------------------------
# 127.0.0.1 = only this machine. Set to your LAN IP (or 0.0.0.0) to use the
# proxy from other devices; keep the proxy password then.
BIND_ADDR=127.0.0.1
PROXY_PORT=8888
ROTATOR_PORT=8081
# Your LAN, so tunnelled traffic can still reach local services, e.g. 192.168.1.0/24
LAN_SUBNETS=

# --- Secrets (generated by setup.sh) ---------------------------------------
PROXY_USER=scraper
PROXY_PASSWORD=
CONTROL_API_KEY=
ROTATOR_API_KEY=

# --- Rotation tuning -------------------------------------------------------
ROTATE_MAX_ATTEMPTS=3
ROTATE_ATTEMPT_TIMEOUT=30
